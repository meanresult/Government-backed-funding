#!/bin/sh
# Keep the project toolchain, Python installations, and caches inside this checkout.
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_uv="$project_root/.tools/uv/uv"

if [ ! -x "$project_uv" ]; then
    printf '%s\n' 'Project uv is missing. Follow the local setup instructions in README.md.' >&2
    exit 1
fi

export UV_CACHE_DIR="$project_root/.tools/cache"
export UV_PYTHON_INSTALL_DIR="$project_root/.tools/python"
export UV_PYTHON_CACHE_DIR="$project_root/.tools/python-cache"
export UV_PYTHON_BIN_DIR="$project_root/.tools/bin"
export UV_PYTHON_PREFERENCE=only-managed
export UV_PROJECT_ENVIRONMENT="$project_root/.venv"
export UV_TOOL_DIR="$project_root/.tools/tool-envs"
export UV_TOOL_BIN_DIR="$project_root/.tools/bin"

exec "$project_uv" --directory "$project_root" "$@"
